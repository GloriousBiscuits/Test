{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*Microsoft.*365.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-outbound-mail.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*Notion.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-notion-writes.py\""
          }
        ]
      }
    ]
  }
}
